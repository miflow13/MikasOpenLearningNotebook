---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const href=(post:(typeof posts)[number])=>post.data.externalUrl??`${base}writing/${post.id}/`;
const formatDate=(date:Date)=>date.toLocaleDateString('en-US',{year:'numeric',month:'short',day:'2-digit',timeZone:'UTC'});
---
<BaseLayout title="Writing" description="Essays and longer writing from Mika Flowers.">
  <section>
    <p class="kicker">essays + articles</p>
    <h2>Writing</h2>
    <p>Longer thoughts from the same workbench: software, Linux, learning, design, and whatever I am trying to understand next.</p>
    <ul class="post-list">{posts.map((post)=><li><span class="post-date">{formatDate(post.data.date)}</span><div><a href={href(post)}>{post.data.title}{post.data.externalUrl?' ↗':''}</a><p class="post-description">{post.data.description}</p></div></li>)}</ul>
  </section>
</BaseLayout>
