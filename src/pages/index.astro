---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a,b)=>b.data.order-a.data.order);
const featured = notes.find((note)=>note.data.featured) ?? notes[0];
const latest = notes.filter((note)=>note.id!==featured?.id).slice(0,8);
const topics=[...new Set(notes.map((note)=>note.data.topic))];
---
<BaseLayout>
<section><p class="notice"><strong>I learn by making the thing first.</strong> This is the trail I leave behind: concepts, bugs, wrong turns, architecture decisions, and the moment something finally clicks.</p></section>
{featured && <><hr/><section aria-labelledby="start-heading"><p class="kicker" id="start-heading">pinned field note</p><p class="featured-title"><a href={`${base}notes/${featured.id}/`}>{featured.data.title}</a></p><p class="meta">{featured.data.topic}</p><p>{featured.data.description}</p><p><a href={`${base}notes/${featured.id}/`}>open note →</a></p></section></>}
<hr/><section aria-labelledby="notes-heading"><p class="kicker">recent observations</p><h2 id="notes-heading">What I've been figuring out</h2><ul class="note-list">{latest.map((note)=><li><span class="topic-label">{note.data.topic}</span><br/><a href={`${base}notes/${note.id}/`}>{note.data.title}</a><p class="note-description">{note.data.description}</p></li>)}</ul><p><a href={`${base}notes/`}>open the whole notebook →</a></p></section>
<hr/><section aria-labelledby="topics-heading"><p class="kicker">index</p><h2 id="topics-heading">The map keeps growing</h2><p>{topics.join(' · ')}</p><p><a href={`${base}topics/`}>browse the map →</a></p></section>
</BaseLayout>
