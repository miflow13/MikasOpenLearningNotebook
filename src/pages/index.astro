---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { compareNotesNewestFirst, displayNoteTitle } from '../lib/noteDates';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const topicSlug = (value: string) => value
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/&/g, ' and ')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort(compareNotesNewestFirst);

const topicNames = [...new Set(notes.map((note) => note.data.topic))].sort();
const topics = topicNames.map((name) => ({
  name,
  slug: topicSlug(name),
  count: notes.filter((note) => note.data.topic === name).length,
}));
const recent = notes.slice(0, 12);
---
<BaseLayout title="Open Learning Notebook" description="Mika's public notebook of programming, Linux, software, debugging, and tooling notes.">
  <section class="intro">
    <h2>my learning of all the things</h2>
    <p>This is my public notebook. I write down what I learn while building software, debugging things, reading documentation, and changing my mind about how something works.</p>
    <p><a href={`${base}notes/`}>browse all entries</a>, <a href={`${base}days/`}>browse by day</a>, or start with a topic below.</p>
  </section>

  <section>
    <h2>topics</h2>
    <ul class="topic-list">
      {topics.map((topic) => (
        <li>
          <a href={`${base}topics/${topic.slug}/`}>{topic.name}</a>
          <span class="topic-count">{topic.count}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>recent entries</h2>
    <ul class="note-list">
      {recent.map((note) => (
        <li>
          <span class="topic-label">{note.data.topic}</span>
          <a href={`${base}notes/${note.id}/`}>{displayNoteTitle(note)}</a>
          <p class="note-description">{note.data.description}</p>
        </li>
      ))}
    </ul>
    <p><a href={`${base}notes/`}>all entries →</a></p>
  </section>
</BaseLayout>
