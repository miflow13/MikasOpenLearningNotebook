---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const featured = notes.find((note) => note.data.featured) ?? notes[0];
const latest = notes.filter((note) => note.id !== featured?.id).slice(0, 6);
const topics = [...new Set(notes.map((note) => note.data.topic))];
---
<BaseLayout>
  <section>
    <p class="notice"><strong>Hi, I'm Mika.</strong> This is my public notebook for the things I learn while programming, debugging, building Linux software, making art, and figuring things out the hard way.</p>
    <p>
      These notes are written in my own words so I can return to them later. Some are fundamentals, some came directly from bugs, and some are things I am still practicing.
    </p>
  </section>

  {featured && (
    <>
      <hr />
      <section aria-labelledby="start-heading">
        <p class="kicker" id="start-heading">start here</p>
        <p class="featured-title"><a href={`${base}notes/${featured.id}/`}>{featured.data.title}</a></p>
        <p class="meta">{featured.data.topic}</p>
        <p>{featured.data.description}</p>
        <p><a href={`${base}notes/${featured.id}/`}>read note →</a></p>
      </section>
    </>
  )}

  <hr />
  <section aria-labelledby="notes-heading">
    <h2 id="notes-heading">Learning notes</h2>
    <ul class="note-list">
      {latest.map((note) => (
        <li>
          <span class="topic-label">{note.data.topic}</span><br />
          <a href={`${base}notes/${note.id}/`}>{note.data.title}</a>
          <p class="note-description">{note.data.description}</p>
        </li>
      ))}
    </ul>
    <p><a href={`${base}notes/`}>all notes →</a></p>
  </section>

  <hr />
  <section aria-labelledby="topics-heading">
    <h2 id="topics-heading">Topics</h2>
    <p>{topics.join(' · ')}</p>
    <p><a href={`${base}topics/`}>browse by topic →</a></p>
  </section>
</BaseLayout>
