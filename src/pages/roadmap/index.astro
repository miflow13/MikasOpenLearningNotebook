---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressNotice from '../../components/ProgressNotice.astro';
import RoadmapOnboarding from '../../components/RoadmapOnboarding.astro';
import RoadmapPhase from '../../components/RoadmapPhase.astro';
import RoadmapSettings from '../../components/RoadmapSettings.astro';
import TrailSelector from '../../components/TrailSelector.astro';
import {
  getSkillsForPhase,
  getSkillsForTrail,
  roadmapPhases,
  roadmapSkills,
  roadmapTrails,
} from '../../data/roadmap';
import { validateFieldNoteRefs, validateRoadmap } from '../../data/roadmap-validation';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const notes = await getCollection('notes', ({ data }) => !data.draft);
const errors = [
  ...validateRoadmap(roadmapSkills, roadmapPhases, roadmapTrails),
  ...validateFieldNoteRefs(roadmapSkills, new Set(notes.map((note) => note.id))),
];
if (errors.length) throw new Error(`Invalid roadmap content:\n${errors.join('\n')}`);
---
<BaseLayout title="Self-taught developer roadmap" description="A practical, build-first roadmap for self-taught software developers.">
  <section class="roadmap-intro">
    <p class="kicker">start here</p>
    <h2>An open roadmap for self-taught developers</h2>
    <p>This is a living roadmap, not a claim of mastery. It is a build-first path through the concepts that make it easier to create software, understand what it is doing, debug it when it breaks, and explain your decisions to someone else.</p>
    <div class="roadmap-principle"><strong>The loop:</strong> learn enough → build something → break something → debug it → explain what happened → repeat.</div>
    <p>You do not need to finish one phase perfectly before touching the next. Use the spine for orientation, then follow the problems your projects reveal.</p>
  </section>

  <ProgressNotice />
  <section class="roadmap-workspace" data-roadmap-workspace data-roadmap-base={base}>
    <div class="roadmap-workspace-summary">
      <div>
        <p class="kicker">your private roadmap</p>
        <h2>Pick up where you left off</h2>
        <p data-progress-summary>0 / {roadmapSkills.length} skills touched</p>
      </div>
      <a class="primary-link" data-continue-link href={`${base}roadmap/${roadmapSkills[0].id}/`} hidden>Continue →</a>
    </div>
    <RoadmapOnboarding />
    <TrailSelector />
    <RoadmapSettings />
  </section>

  <section class="roadmap-status-key">
    <p class="kicker">confidence, not completion</p>
    <h2>Reading is not the finish line</h2>
    <p><strong>🌱 Encountered → 🧪 Practicing → 🔨 Applied → 🧠 Can Explain → ✅ Comfortable.</strong> Proof checkpoints help you gather evidence; they do not decide your confidence for you.</p>
  </section>

  <div class="roadmap-phases">
    {roadmapPhases.map((phase) => (
      <RoadmapPhase phase={phase} skills={getSkillsForPhase(phase.id)} base={base} />
    ))}
  </div>

  <section class="specialization-section" id="trails">
    <p class="kicker">branch without getting lost</p>
    <h2>Choose trails based on what you want to build</h2>
    <p>Trails reuse the same skills instead of creating separate curricula. You can follow more than one and still see the whole roadmap.</p>
    <div class="trail-grid">
      {roadmapTrails.map((trail) => (
        <article class="trail-card">
          <p class="topic-label">trail</p>
          <h3>{trail.title}</h3>
          <p>{trail.summary}</p>
          <ul>
            {getSkillsForTrail(trail.id).slice(0, 8).map((skill) => (
              <li><a href={`${base}roadmap/${skill.id}/`}>{skill.title}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="roadmap-next">
    <p class="kicker">the messy middle matters</p>
    <h2>Watch the roadmap get tested in real projects</h2>
    <p>The field notes are the durable lessons. The Journey is where I document what I am learning now, including mistakes, blind spots, bugs, and the things I thought I understood until a project proved otherwise.</p>
    <p><a href={`${base}journey/`}>follow the learning journey →</a> · <a href={`${base}projects/`}>see the projects behind the notes →</a></p>
  </section>
  <script>
    import { initRoadmapProgress } from '../../scripts/roadmap-progress';
    initRoadmapProgress();
  </script>
</BaseLayout>
