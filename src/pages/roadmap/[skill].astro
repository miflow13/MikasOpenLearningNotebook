---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CareerContext from '../../components/CareerContext.astro';
import CheckpointList from '../../components/CheckpointList.astro';
import ConfidenceControl from '../../components/ConfidenceControl.astro';
import ProgressNotice from '../../components/ProgressNotice.astro';
import TrailBadge from '../../components/TrailBadge.astro';
import {
  getSkillById,
  roadmapPhases,
  type RoadmapSkill,
} from '../../data/roadmap';
import { getSkillRouteIds } from '../../data/roadmap-routing';

export function getStaticPaths() {
  return getSkillRouteIds().map((id) => ({
    params: { skill: id },
    props: { skill: getSkillById(id)! },
  }));
}

const { skill } = Astro.props as { skill: RoadmapSkill };
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const phase = roadmapPhases.find((item) => item.id === skill.phase)!;
const notes = await getCollection('notes', ({ data }) => !data.draft);
const noteMap = new Map(notes.map((note) => [note.id, note]));
const relatedNotes = skill.fieldNoteIds.map((id) => noteMap.get(id)).filter(Boolean);
const nextSkills = skill.next.map((id) => getSkillById(id)).filter(Boolean);
---
<BaseLayout title={skill.title} description={skill.summary}>
  <article class="skill-page">
    <header class="skill-header">
      <p class="kicker">phase {phase.number} · {phase.title}</p>
      <h2 class="article-title">{skill.title}</h2>
      <p class="article-description">{skill.summary}</p>
      {skill.trails.length > 0 && (
        <div class="trail-badge-row" aria-label="Learning trails">
          {skill.trails.map((trail) => <TrailBadge trail={trail} />)}
        </div>
      )}
    </header>

    <ProgressNotice />
    <section class="skill-confidence-preview" aria-labelledby="confidence-title">
      <p class="kicker">your learning</p>
      <h2 id="confidence-title">Choose your own confidence</h2>
      <ConfidenceControl skill={skill} />
    </section>

    <section class="skill-section">
      <p class="kicker">why this matters</p>
      <h2>Why this belongs on the map</h2>
      <p>{skill.why}</p>
    </section>

    <section class="skill-section">
      <p class="kicker">scope</p>
      <h2>What you actually need to know</h2>
      <ul>{skill.needToKnow.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="mental-model">
      <p class="kicker">mental model</p>
      <h2>A useful way to think about it</h2>
      <p>{skill.mentalModel}</p>
    </section>

    <CheckpointList skill={skill} />

    {relatedNotes.length > 0 && (
      <section class="skill-section">
        <p class="kicker">from the notebook</p>
        <h2>Related field notes</h2>
        <ul class="roadmap-note-list">
          {relatedNotes.map((note) => note && (
            <li>
              <a href={`${base}notes/${note.id}/`}>{note.data.title}</a>
              <span>{note.data.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {nextSkills.length > 0 && (
      <section class="skill-section">
        <p class="kicker">keep moving</p>
        <h2>Next directions</h2>
        <ul class="next-skill-list">
          {nextSkills.map((next) => next && (
            <li>
              <a href={`${base}roadmap/${next.id}/`}>{next.title}</a>
              <span>{next.summary}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <CareerContext career={skill.career} />

    <aside class="mika-notebook-context">
      <p class="kicker">from Mika's notebook</p>
      <h2>How this shows up in my own journey</h2>
      <p>My personal relationship with this topic stays separate from your progress. The Journey shows where I am focusing, what I have built with, and what I still do not understand well.</p>
      <p><a href={`${base}journey/`}>follow my current learning frontier →</a></p>
    </aside>
  </article>
  <script>
    import { initRoadmapProgress } from '../../scripts/roadmap-progress';
    initRoadmapProgress();
  </script>
</BaseLayout>
