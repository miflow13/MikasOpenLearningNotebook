---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.order - a.data.order);
---
<BaseLayout title="entries" description="All entries from Mika's public learning notebook.">
  <h2>entries</h2>
  <p>Everything I've written down while learning and building.</p>
  <ul class="note-list">
    {notes.map((note) => (
      <li>
        <span class="topic-label">{note.data.topic}</span>
        <a href={`${base}notes/${note.id}/`}>{note.data.title}</a>
        <p class="note-description">{note.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
