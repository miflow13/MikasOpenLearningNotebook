---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { compareNotesNewestFirst, displayNoteTitle } from '../../lib/noteDates';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort(compareNotesNewestFirst);
---
<BaseLayout title="entries" description="All entries from Mika's public learning notebook.">
  <h2>entries</h2>
  <p>Everything I've written down while learning and building. You can also <a href={`${base}days/`}>browse by day</a>.</p>
  <ul class="note-list">
    {notes.map((note) => (
      <li>
        <span class="topic-label">{note.data.topic}</span>
        <a href={`${base}notes/${note.id}/`}>{displayNoteTitle(note)}</a>
        <p class="note-description">{note.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
