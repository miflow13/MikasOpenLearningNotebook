---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const topicSlug = (value: string) => value
  .toLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/&/g, ' and ')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '');

const notes = await getCollection('notes', ({ data }) => !data.draft);
const topicNames = [...new Set(notes.map((note) => note.data.topic))].sort();
const topics = topicNames.map((name) => ({
  name,
  slug: topicSlug(name),
  count: notes.filter((note) => note.data.topic === name).length,
}));
---
<BaseLayout title="topics" description="Browse Mika's learning notebook by topic.">
  <h2>topics</h2>
  <p>Everything in the notebook, grouped by subject.</p>
  <ul class="topic-list">
    {topics.map((topic) => (
      <li>
        <a href={`${base}topics/${topic.slug}/`}>{topic.name}</a>
        <span class="topic-count">{topic.count}</span>
      </li>
    ))}
  </ul>
</BaseLayout>
