---
import type { RoadmapSkill } from '../data/roadmap';

interface Props { skill: RoadmapSkill; }
const { skill } = Astro.props;
const states = [
  { id: 'encountered', emoji: '🌱', label: 'Encountered' },
  { id: 'practicing', emoji: '🧪', label: 'Practicing' },
  { id: 'applied', emoji: '🔨', label: 'Applied' },
  { id: 'can-explain', emoji: '🧠', label: 'Can Explain' },
  { id: 'comfortable', emoji: '✅', label: 'Comfortable' },
] as const;
---
<fieldset class="confidence-control" data-confidence-control data-skill-id={skill.id}>
  <legend>Your confidence</legend>
  <p class="small">Choose the state that feels true today. Evidence can suggest progress, but the site never promotes you automatically.</p>
  <div class="confidence-options">
    {states.map((state) => (
      <label class="confidence-option">
        <input
          type="radio"
          name={`confidence-${skill.id}`}
          value={state.id}
          data-confidence={state.id}
        />
        <span aria-hidden="true">{state.emoji}</span>
        <span>{state.label}</span>
      </label>
    ))}
  </div>
</fieldset>
