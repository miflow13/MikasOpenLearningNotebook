<details class="roadmap-settings" data-roadmap-settings>
  <summary>Roadmap settings</summary>
  <div class="roadmap-settings-body">
    <p class="small">Progress is stored only in this browser. Export a backup if you want to move it to another device or browser.</p>
    <div class="roadmap-settings-actions">
      <button type="button" data-export-progress>Export progress</button>
      <label class="file-action">
        <span>Import progress</span>
        <input type="file" accept="application/json,.json" data-import-progress />
      </label>
      <button type="button" data-reset-progress>Reset roadmap</button>
    </div>
    <p class="small" data-settings-status aria-live="polite"></p>
  </div>
</details>
