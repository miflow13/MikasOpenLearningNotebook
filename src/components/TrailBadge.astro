---
import { roadmapTrails, type TrailId } from '../data/roadmap';

interface Props {
  trail: TrailId;
}

const { trail } = Astro.props;
const item = roadmapTrails.find((entry) => entry.id === trail);
const label = item?.title ?? trail;
---
<span class="trail-badge" data-trail={trail}>{label}</span>
