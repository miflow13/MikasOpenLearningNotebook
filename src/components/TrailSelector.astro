---
import { roadmapTrails } from '../data/roadmap';
---
<fieldset class="trail-selector" data-trail-selector>
  <legend>Your trails</legend>
  <p class="small">Choose any that match what you want to build. Selected trails change emphasis and recommendations; they never hide the rest of the roadmap.</p>
  <div class="trail-selector-options">
    {roadmapTrails.map((trail) => (
      <label>
        <input type="checkbox" value={trail.id} data-trail-input />
        <span>{trail.title}</span>
      </label>
    ))}
  </div>
</fieldset>
