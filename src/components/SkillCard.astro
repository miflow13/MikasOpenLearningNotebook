---
import type { RoadmapSkill } from '../data/roadmap';
import TrailBadge from './TrailBadge.astro';

interface Props {
  skill: RoadmapSkill;
  base: string;
}

const { skill, base } = Astro.props;
---
<article
  class="skill-card"
  data-skill-card
  data-skill-id={skill.id}
  data-trails={skill.trails.join(' ')}
>
  <div class="skill-card-topline">
    <span class="topic-label">{skill.phase}</span>
    {skill.trails.length > 0 && (
      <div class="trail-badge-row" aria-label="Learning trails">
        {skill.trails.map((trail) => <TrailBadge trail={trail} />)}
      </div>
    )}
  </div>
  <h3><a href={`${base}roadmap/${skill.id}/`}>{skill.title}</a></h3>
  <p>{skill.summary}</p>
  <div class="skill-card-footer">
    <span class="skill-confidence-label" data-skill-confidence-status>Not started</span>
    <a class="skill-card-link" href={`${base}roadmap/${skill.id}/`}>open skill →</a>
  </div>
</article>
