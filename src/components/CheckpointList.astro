---
import type { RoadmapSkill } from '../data/roadmap';

interface Props { skill: RoadmapSkill; }
const { skill } = Astro.props;
---
<section class="skill-section" aria-labelledby="evidence-title" data-checkpoint-list data-skill-id={skill.id}>
  <p class="kicker">evidence, not completion</p>
  <h2 id="evidence-title">Prove you understand it</h2>
  <ul class="checkpoint-control-list">
    {skill.checkpoints.map((checkpoint) => (
      <li>
        <label>
          <input
            type="checkbox"
            data-checkpoint-id={checkpoint.id}
            data-skill-id={skill.id}
          />
          <span>{checkpoint.label}</span>
        </label>
      </li>
    ))}
  </ul>
  <p class="small" data-checkpoint-summary aria-live="polite">0 / {skill.checkpoints.length} evidence checkpoints complete.</p>
</section>
