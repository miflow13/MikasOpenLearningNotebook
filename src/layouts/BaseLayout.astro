---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'my learning of all the things',
  description = "Mika's public learning notebook for programming, Linux, software engineering, debugging, design, and tooling."
} = Astro.props;
const pageTitle = title === 'my learning of all the things' ? title : `${title} · my learning of all the things`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <SiteHeader />
    <hr />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
